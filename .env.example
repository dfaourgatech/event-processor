# Which transport the processor consumes from: kafka | sqs
TRANSPORT=kafka

# Host-side endpoints (when running the processor/producer outside Docker).
# Inside Compose these are set to the service names automatically.
KAFKA_BOOTSTRAP=localhost:9092
SQS_ENDPOINT=http://localhost:4566
DATABASE_URL=postgresql://events:events@localhost:5432/events

KAFKA_TOPIC=events.inbound
KAFKA_DLQ_TOPIC=events.dlq
KAFKA_GROUP_ID=event-processor
SQS_QUEUE=events-inbound
SQS_DLQ=events-dlq

# Processing behavior
MAX_ATTEMPTS=3
SCHEMA_DIR=schemas
